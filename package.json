{
  "name": "dsh-token-cost",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness token cost meter: shows the current session's estimated model cost beside the built-in token usage pill, priced with the official DeepSeek price list and peak/off-peak rates.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "token",
    "cost",
    "usage",
    "pricing"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "fold.js",
    "pricing.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/fold.test.js test/pricing.test.js",
    "check": "node --check index.js && node --check fold.js && node --check pricing.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
